# Preview is functional without any credentials. All sample catalogue/shipping data is illustrative.
NEXT_PUBLIC_STORE_MODE=preview
# Set to supabase to preview your real database while keeping payments disabled.
STORE_DATA_SOURCE=sample
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server ONLY. Never use NEXT_PUBLIC_ for secret keys.
SUPABASE_SECRET_KEY=

# Optional live adapter. Merchant must approve provider and international card acceptance first.
PAYSTACK_SECRET_KEY=
INTERNATIONAL_PAYMENTS_ENABLED=false
LIVE_CHECKOUT_ENABLED=false
# Reviewed shipping/customs/refund policies are also required before live checkout.
COMMERCE_POLICIES_APPROVED=false

# Public enquiry submission uses Cloudflare Turnstile in live mode.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional transactional delivery worker. Provision a verified sender and scheduler.
RESEND_API_KEY=
EMAIL_FROM=
STUDIO_EMAIL=
CRON_SECRET=
